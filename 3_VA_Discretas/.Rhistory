set.seed(456)
tamanos_n <- c(5, 15, 30, 60, 120)
replicaciones <- 800
# Función auxiliar para simular la población truncada (> 0.3)
generar_muestra_truncada <- function(n) {
valores <- c()
while(length(valores) < n) {
intentos <- runif(n * 2)
filtrados <- intentos[intentos > 0.3]
valores <- c(valores, filtrados)
}
return(valores[1:n])
}
# Data frame para almacenar resultados de la simulación
resultados_tcl <- data.frame()
# Bucle interactivo por cada tamaño muestral con cálculo manual de estadísticos
for (n_val in tamanos_n) {
medias <- replicate(replicaciones, mean(generar_muestra_truncada(n_val)))
# === CÁLCULOS MATEMÁTICOS MANUALES (SIN LIBRERÍAS) ===
# Asimetría (Skewness)
sk <- sum((medias - mean(medias))^3) / (length(medias) * sd(medias)^3)
# Curtosis (Kurtosis)
kt <- sum((medias - mean(medias))^4) / (length(medias) * sd(medias)^4)
cat(paste0("Muestra n = ", n_val, " -> Skewness: ", round(sk, 4), " | Kurtosis: ", round(kt, 4), "\n"))
resultados_tcl <- rbind(resultados_tcl, data.frame(Media = medias, n = as.factor(n_val)))
}
# Generación de gráficos facetados por tamaño de muestra
ggplot(resultados_tcl, aes(x = Media)) +
geom_histogram(aes(y = ..density..), bins = 25, fill = "#f5ABBB", color = "#ce4a8E") +
facet_wrap(~n, scales = "free", labeller = label_both) +
geom_density(color = "#8B4C41", size = 1) +
labs(title = "Efecto del TCL sobre Medias de Distribuciones Asimétricas",
x = "Medias Muestrales", y = "Densidad") +
theme_minimal()
# Realizar pruebas de normalidad para n=100
medias_n100 <- df_tcl[df_tcl$n == 100, "medias"]
# Prueba de Shapiro-Wilk
shapiro_test <- shapiro.test(medias_n100)
# Realizar pruebas de normalidad para n = 120 (el tamaño más grande simulado)
medias_n120 <- resultados_tcl[resultados_tcl$n == 120, "Media"]
# Prueba de Shapiro-Wilk
shapiro_test <- shapiro.test(medias_n120)
# Q-Q plot para n = 120
ggplot(data.frame(medias = medias_n120), aes(sample = medias)) +
geom_qq() +
geom_qq_line(color = "red", linewidth = 1) +
labs(title = "Q-Q Plot - Medias Muestrales (n = 120)",
subtitle = paste("Prueba Shapiro-Wilk: W =", round(shapiro_test$statistic, 4),
", p-valor =", round(shapiro_test$p.value, 4)),
x = "Cuantiles teóricos (Normal)",
y = "Cuantiles observados") +
theme_minimal() +
theme(plot.title = element_text(hjust = 0.5),
plot.subtitle = element_text(hjust = 0.5))
# Realizar pruebas de normalidad para n=100
medias_n100 <- df_tcl[df_tcl$n == 100, "medias"]
# Prueba de Shapiro-Wilk
shapiro_test <- shapiro.test(medias_n100)
# Realizar pruebas de normalidad para n=100
medias_n100 <- df_tcl[df_tcl$n == 100, "medias"]
# Prueba de Shapiro-Wilk
shapiro_test <- shapiro.test(medias_n100)
# Q-Q plot para n=100
ggplot(data.frame(medias = medias_n100), aes(sample = medias)) +
geom_qq() +
geom_qq_line(color = "#D5306D", size = 1) +
labs(title = "Q-Q Plot - Medias Muestrales (n=100)",
subtitle = paste("Prueba Shapiro-Wilk: W =", round(shapiro_test$statistic, 4),
", p-valor =", round(shapiro_test$p.value, 4)),
x = "Cuantiles teóricos (Normal)",
y = "Cuantiles observados") +
theme_minimal() +
theme(plot.title = element_text(hjust = 0.5),
plot.subtitle = element_text(hjust = 0.5))
# Calcular estadísticos para cada tamaño de muestra
estadisticos_tcl <- df_tcl %>%
group_by(n) %>%
summarise(
media_observada = mean(medias),
varianza_observada = var(medias),
desv_std_observada = sd(medias),
varianza_teorica = first(varianza_teorica_media),
desv_std_teorica = first(desv_std_teorica_media),
.groups = 'drop'
)
# Calcular estadísticos para cada tamaño de muestra
# 1. Definir los parámetros teóricos de la población truncada unif(0.3, 1)
a <- 0.3
b <- 1.0
# Varianza teórica de la población: (b - a)^2 / 12
varianza_poblacional <- ((b - a)^2) / 12
# 2. Calcular estadísticos observados y teóricos por tamaño de muestra
estadisticos_tcl <- resultados_tcl %>%
group_by(n) %>%
summarise(
media_observada   = mean(Media),
varianza_observada = var(Media),
desv_std_observada = sd(Media),
# La varianza teórica de la media disminuye según el tamaño n: var / n
varianza_teorica   = varianza_poblacional / as.numeric(as.character(n)),
desv_std_teorica   = sqrt(varianza_teorica),
.groups = 'drop'
)
# Calcular estadísticos para cada tamaño de muestra
# 1. Definir los parámetros teóricos de la población truncada unif(0.3, 1)
a <- 0.3
b <- 1.0
# Varianza teórica de la población: (b - a)^2 / 12
varianza_poblacional <- ((b - a)^2) / 12
# 2. Calcular estadísticos observados y teóricos por tamaño de muestra
estadisticos_tcl <- resultados_tcl %>%
group_by(n) %>%
summarise(
media_observada   = mean(Media),
varianza_observada = var(Media),
desv_std_observada = sd(Media),
# Calculamos directamente la varianza teórica de la uniforme (0.3, 1) dividida entre n
varianza_teorica   = (((1.0 - 0.3)^2) / 12) / as.numeric(as.character(n[1])),
desv_std_teorica   = sqrt(varianza_teorica),
.groups = 'drop'
)
# 3. Mostrar la tabla con formato elegante
knitr::kable(estadisticos_tcl,
caption = "Comparación de varianzas teóricas vs observadas bajo el TCL",
digits = 4) %>%
kableExtra::kable_styling(bootstrap_options = c("striped", "hover", "condensed"))
# Gráfico de convergencia de varianzas
ggplot(estadisticos_tcl, aes(x = n)) +
geom_point(aes(y = varianza_observada, color = "Observada"), size = 3) +
geom_line(aes(y = varianza_observada, color = "Observada"), size = 1) +
geom_point(aes(y = varianza_teorica, color = "Teórica"), size = 3) +
geom_line(aes(y = varianza_teorica, color = "Teórica"), size = 1) +
scale_color_manual(values = c("Observada" = "blue", "Teórica" = "red")) +
labs(title = "Disminución de la Varianza de las Medias Muestrales",
subtitle = "Var(X̄) = σ²/n",
x = "Tamaño de muestra (n)",
y = "Varianza de las medias",
color = "Tipo") +
theme_minimal() +
theme(plot.title = element_text(hjust = 0.5),
plot.subtitle = element_text(hjust = 0.5))
