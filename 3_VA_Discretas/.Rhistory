while(length(valores) < n) {
intentos <- runif(n * 2)
filtrados <- intentos[intentos > 0.3]
valores <- c(valores, filtrados)
}
return(valores[1:n])
}
# Data frame para almacenar resultados de la simulación
resultados_tcl <- data.frame()
# Bucle interactivo por cada tamaño muestral con cálculo manual de estadísticos
for (n_val in tamanos_n) {
medias <- replicate(replicaciones, mean(generar_muestra_truncada(n_val)))
# === CÁLCULOS MATEMÁTICOS MANUALES (SIN LIBRERÍAS) ===
# Asimetría (Skewness)
sk <- sum((medias - mean(medias))^3) / (length(medias) * sd(medias)^3)
# Curtosis (Kurtosis)
kt <- sum((medias - mean(medias))^4) / (length(medias) * sd(medias)^4)
cat(paste0("Muestra n = ", n_val, " -> Skewness: ", round(sk, 4), " | Kurtosis: ", round(kt, 4), "\n"))
resultados_tcl <- rbind(resultados_tcl, data.frame(Media = medias, n = as.factor(n_val)))
}
# Generación de gráficos facetados por tamaño de muestra
ggplot(resultados_tcl, aes(x = Media)) +
geom_histogram(aes(y = ..density..), bins = 25, fill = "lightgreen", color = "black") +
facet_wrap(~n, scales = "free", labeller = label_both) +
geom_density(color = "darkgreen", size = 1) +
labs(title = "Efecto del TCL sobre Medias de Distribuciones Asimétricas",
x = "Medias Muestrales", y = "Densidad") +
theme_minimal()
set.seed(789)
n_puntos <- 20000 # Cantidad de iteraciones para la aproximación
# Generamos coordenadas (x, y) aleatorias uniformes dentro del plano [-1, 1]
x <- runif(n_puntos, min = -1, max = 1)
y <- runif(n_puntos, min = -1, max = 1)
# Ecuación del círculo unitario: un punto está dentro si la suma de cuadrados <= 1
dentro_circulo <- (x^2 + y^2) <= 1
# Estimación de Pi basada en la proporción de áreas
pi_estimado <- (sum(dentro_circulo) / n_puntos) * 4
cat("El valor estimado para Pi con", n_puntos, "iteraciones es:", pi_estimado, "\n")
# Representación gráfica del experimento de Monte Carlo
df_mc <- data.frame(x = x, y = y, Dentro = dentro_circulo)
ggplot(df_mc, aes(x = x, y = y, color = Dentro)) +
geom_point(alpha = 0.3, size = 0.4) +
coord_fixed() +
scale_color_manual(values = c("tomato", "dodgerblue")) +
labs(title = paste("Estimación por Monte Carlo de Pi =", pi_estimado),
subtitle = "Los puntos azules caen dentro de la circunferencia unitaria") +
theme_minimal()
